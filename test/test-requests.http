###############################
### users endpoint


### Get all users
GET {{apiurl}}/users

### Post login
POST http://localhost:3000/api/auth/login
content-type: application/json

{
  "username": "newuser",
  "password": "securepassword"
}

### Get my user info
GET http://localhost:3000/api/auth/me
Authorization: Bearer {{token}}

### Register new user
POST {{apiurl}}/users
Content-Type: application/json

{
"username": "newuser",
"password": "securepassword",
"email": "newuser@example.com"
}

### Register new user FAIL email missing
POST {{apiurl}}/users
Content-Type: application/json

{"username": "newuser",
"password": "securepassword"}

### Get user by id 1
GET {{apiurl}}/users/1

### Update user by id 13
PUT {{apiurl}}/users/13
Content-Type: application/json

{"username": "updatednewuser",
"email": "newemail@example.com"}

### Delete user by id
DELETE {{apiurl}}/users/14

### User login
POST {{apiurl}}/users/login
Content-Type: application/json

{
 "username": "newuser",
 "password": "securepassword"
}

##############################
### Diary entry endpoints

### Get all entries (by user id in token)
GET {{apiurl}}/entries
Authorization: Bearer {{token}}

### Get entry by id
GET {{apiurl}}/entries/1

### Delete entry by id
DELETE {{apiurl}}/entries/6
Authorization: Bearer {{token}}

### Post new entry
POST {{apiurl}}/entries
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "user_id": 3,
  "entry_date": "2026-02-04",
  "mood": "really happy",
  "weight": 66,
  "sleep_hours": 5,
  "notes": "normipäivä"
}

###############################
### Validation & Authorization tests

### Register FAIL - username too short
POST {{apiurl}}/users
Content-Type: application/json

{
  "username": "ab",
  "password": "securepassword",
  "email": "shortuser@example.com"
}

### Register FAIL - invalid email
POST {{apiurl}}/users
Content-Type: application/json

{
  "username": "validuser",
  "password": "securepassword",
  "email": "not-an-email"
}

### Register FAIL - short password
POST {{apiurl}}/users
Content-Type: application/json

{
  "username": "validuser2",
  "password": "short",
  "email": "user2@example.com"
}

### Register SUCCESS (use unique username/email)
POST {{apiurl}}/users
Content-Type: application/json

{
  "username": "test1234",
  "password": "verysecurepassword",
  "email": "testuser@example.com"
}

### Create entry FAIL - no token provided (should return 401)
POST {{apiurl}}/entries
Content-Type: application/json

{
  "entry_date": "2026-03-08",
  "mood": "ok",
  "notes": "no token test"
}

### Create entry FAIL - invalid date format
POST {{apiurl}}/entries
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "entry_date": "08-03-2026",
  "mood": "ok",
  "notes": "invalid date"
}

### Create entry SUCCESS - valid data and token
POST {{apiurl}}/entries
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "entry_date": "2026-03-08",
  "mood": "Happy",
  "notes": "Testi"
}

### Delete entry FAIL - no token (should return 401)
DELETE {{apiurl}}/entries/6

### Update user FAIL - no token (should return 401)
PUT {{apiurl}}/users/13
Content-Type: application/json

{"username": "attempted_update_no_token"}

### Update user FAIL - token belongs to another user (should return 403)
PUT {{apiurl}}/users/1
Content-Type: application/json
Authorization: Bearer {{token}}

{"username": "attempted_update_other_user"}

